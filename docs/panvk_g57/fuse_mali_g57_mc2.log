# GPU capability readout — Mali-G57 MC2, MediaTek Dimensity 6300
# Source: /dev/mali0 via kbase JM uAPI ioctls (no Mesa code involved)
# Date: 2026-09-27. Unit/firmware-specific; not a conformance claim.

JM uAPI 11.38
TEXTURE_FEATURES_0 (key 9)  = 0xf7fe03fe
TEXTURE_FEATURES_1 (key 10) = 0xc3fff7ff
TEXTURE_FEATURES_2 (key 11) = 0xbfe1ff9f
RAW_TEXFEAT_0 (key 52)      = 0xf7fe03fe
RAW_TEXFEAT_1 (key 53)      = 0xc3fff7ff
RAW_TEXFEAT_2 (key 54)      = 0xbfe1ff9f

# Decoded TEXTURE_FEATURES_0 bits (bit = format decoder block present):
